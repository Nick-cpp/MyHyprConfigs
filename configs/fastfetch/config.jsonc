{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
      "source": "artix2_small",
      "height": 12,
      "position": "left",
      "padding": {
        "top": 1,
        "bottom": 1
    }
  },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "key": "╭────────────────────────────────────────────────────────╮",
            "padding": {
                "bottom": 2
            }
        },
        "break",
        "title",
        {
            "type": "os",
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "format": "{2}h {3}m",
            "keyColor": "blue"
        },
        {
            "type": "disk",
            "key": "OS Age",
            "folders": "/",
            "keyColor": "blue",
            "format": "{days} days {hours} hours {minutes} minutes"
        },
        {
            "type": "wm",
            "keyColor": "blue"
        },
        {
            "type": "de",
            "keyColor": "blue"
        },
        {
            "type": "memory",
            "keyColor": "blue"
        },
        {
            "type": "cpu",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "keyColor": "blue"
        },
        "break",
        {
            "type": "custom",
            "key": "╰────────────────────────────────────────────────────────╯",
            "padding": {
                "top": 2
            }
        }
    ]
}
