// Inspired by Catnap
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/gentoo.txt",
        "padding": {
            "top": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "key": "│  user    {#keys}│",
            "type": "title",
            "format": "{user-name}"
        },
        {
            "key": "│ 󰇅 hname   {#keys}│",
            "type": "title",
            "format": "{host-name}"
        },
        {
            "key": "│ {icon} distro  {#keys}│",
            "type": "os"
        },
        {
            "key": "│ 󰏖 pkgs    {#keys}│",
            "type": "packages"
        },
        {
            "key": "│ 󰅐 uptime  {#keys}│",
            "type": "uptime"
        },
        {
            "key": "│ 󱦟 age     {#keys}│",
            "type": "disk",
            "folders": "/",
            "format": "{years} y {days} d {hours} h {minutes} m"
        },
        {
            "key": "│  kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│  memory  {#keys}│",
            "type": "memory"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│  colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
